#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

/ {
    zmk_pointing {
        compatible = "zmk,pointing";
        motion-acceleration = <0>;
        motion-speed = <1>;
    };
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <350>;
    quick-tap-ms = <0>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <350>;
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        mb1_mb2_to_layer5 {
            bindings = <&mo 5>;
            key-positions = <22 23>;
            timeout-ms = <50>;
            slow-release;
            layers = <4>;
        };

        kl_to_layer10 {
            bindings = <&mo 10>;
            key-positions = <22 23>;
            timeout-ms = <50>;
            slow-release;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        browser_zoom_in_strict: browser_zoom_in_strict {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "BROWSER_ZOOM_IN_STRICT";
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp EQUAL>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LCTRL>
                ;
        };

        browser_zoom_out: browser_zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "BROWSER_ZOOM_OUT";
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp MINUS>
                , <&macro_release &kp LCTRL>
                ;
        };

        browser_zoom_reset: browser_zoom_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "BROWSER_ZOOM_RESET";
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp N0>
                , <&macro_release &kp LCTRL>
                ;
        };

        excel_zoom_in: excel_zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "EXCEL_ZOOM_IN";
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp EQUAL>
                , <&macro_release &kp LALT>
                , <&macro_release &kp LCTRL>
                ;
        };

        excel_zoom_out: excel_zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "EXCEL_ZOOM_OUT";
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp MINUS>
                , <&macro_release &kp LALT>
                , <&macro_release &kp LCTRL>
                ;
        };

        mac_screenshot_tool: mac_screenshot_tool {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "MAC_SCREENSHOT_TOOL";
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_press &kp LGUI>
                , <&macro_tap &kp N5>
                , <&macro_release &kp LGUI>
                , <&macro_release &kp LSHFT>
                ;
        };

        mac_dictation: mac_dictation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "MAC_DICTATION";
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp F5>
                , <&macro_release &kp LGUI>
                ;
        };

        win_voice_typing: win_voice_typing {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "WIN_VOICE_TYPING";
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp H>
                , <&macro_release &kp LGUI>
                ;
        };

        win_screenshot_tool: win_screenshot_tool {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "WIN_SCREENSHOT_TOOL";
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp S>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LGUI>
                ;
        };

        mac_mission_control: mac_mission_control {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "MAC_MISSION_CONTROL";
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp UP_ARROW>
                , <&macro_release &kp LCTRL>
                ;
        };

        mac_app_switcher: mac_app_switcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "MAC_APP_SWITCHER";
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_release &kp LGUI>
                ;
        };

        mac_space_left: mac_space_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "MAC_SPACE_LEFT";
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp LEFT_ARROW>
                , <&macro_release &kp LCTRL>
                ;
        };

        mac_space_right: mac_space_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "MAC_SPACE_RIGHT";
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp RIGHT_ARROW>
                , <&macro_release &kp LCTRL>
                ;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&mo>, <&to_layer_0>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        mclk_or_scroll: mclk_or_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "MCLK_OR_SCROLL";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&mkp>;
        };

        rc_or_mclk: rc_or_mclk {
            compatible = "zmk,behavior-hold-tap";
            label = "RC_OR_MCLK";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mkp>, <&mkp>;
        };

        win_minus_under: win_minus_under {
            compatible = "zmk,behavior-mod-morph";
            label = "WIN_MINUS_UNDER";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT1)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_plus_equal: win_plus_equal {
            compatible = "zmk,behavior-mod-morph";
            label = "WIN_PLUS_EQUAL";
            #binding-cells = <0>;
            bindings = <&kp LS(SEMI)>, <&kp LS(MINUS)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_colon_semi: win_colon_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "WIN_COLON_SEMI";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_layer4_plus_equal: win_layer4_plus_equal {
            compatible = "zmk,behavior-hold-tap";
            label = "WIN_L4_PLUS_EQUAL";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&win_plus_equal>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp Q     &kp W     &kp E   &kp R  &kp T                                                 &kp Y        &kp U  &kp I      &kp O    &kp P        &kp MINUS
&kp TAB     &lt 4 A    &kp S     &kp D   &kp F  &kp G        &mclk_or_scroll 5 MCLK    &kp LC(UP)     &kp H        &kp J  &kp K      &kp L    &lt 4 EQUAL  &kp SEMI
&kp LSHIFT  &kp Z     &kp X     &kp C   &kp V  &kp B        &mt LGUI LC(LEFT)         &mt RSHFT LC(RIGHT)  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH    &mt RSHFT LBKT
&kp LGUI    &kp LALT  &kp LGUI  &trans  &mo 6  &lt 3 SPACE   &lt 2 LANG2                 &lt 2 LANG1      &lt 3 ENTER                             &kp RALT     &mt LGUI RBKT
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_1 {
            bindings = <
&kp ESC     &kp Q     &kp W     &kp E   &kp R  &kp T                                               &kp Y        &kp U  &kp I      &kp O    &kp P            &win_minus_under
&kp TAB     &lt 4 A    &kp S     &kp D   &kp F  &kp G        &mclk_or_scroll 5 MCLK    &kp LG(TAB)   &kp H        &kp J  &kp K      &kp L    &win_layer4_plus_equal 4 0  &win_colon_semi
&kp LSHIFT  &kp Z     &kp X     &kp C   &kp V  &kp B        &mt LCTRL LS(LA(TAB))     &mt RSHFT LA(TAB)   &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH        &mt RSHFT RBKT
&kp LCTRL   &kp LALT  &kp LGUI  &trans  &mo 6  &lt 3 SPACE   &lt 7 INT5                  &lt 7 INT4      &lt 3 ENTER                             &kp RALT         &mt LCTRL BSLH
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_2 {
            bindings = <
&trans  &trans    &trans   &trans    &trans     &trans                      &trans   &trans       &trans         &trans        &mac_screenshot_tool    &trans
&trans  &kp EXCL  &kp DQT  &kp HASH  &kp DLLR   &kp BSPC  &trans    &trans  &kp DEL  &kp PERCENT  &kp AMPERSAND  &kp SQT       &kp AT_SIGN             &kp TILDE
&trans  &trans    &trans   &trans    &kp GRAVE  &trans    &trans    &trans  &trans   &kp CARET    &kp PIPE       &kp ASTERISK  &kp UNDER               &kp LEFT_PARENTHESIS
&trans  &trans    &trans   &trans    &trans     &trans    &trans    &trans  &trans                                             &trans                  &kp RIGHT_PARENTHESIS
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_3 {
            bindings = <
&trans  &kp SLASH  &kp N7      &kp N8  &kp N9  &trans                       &trans   &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp ASTRK  &kp N4      &kp N5  &kp N6  &kp BSPC   &trans    &trans  &kp DEL  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &kp MINUS  &kp N1      &kp N2  &kp N3  &kp EQUAL  &trans    &trans  &trans   &kp F1  &kp F2  &kp F3  &kp F12  &trans
&trans  &kp PLUS   &kp PERIOD  &kp N0  &trans  &trans     &trans    &trans  &trans                           &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        layer_4 {
            bindings = <
&browser_zoom_in_strict  &excel_zoom_in   &kp HOME        &kp UP_ARROW    &kp PAGE_UP      &trans                              &kp HOME        &mkp MB4        &kp UP_ARROW    &kp PAGE_UP             &trans  &trans
&browser_zoom_out        &excel_zoom_out  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp BSPC  &trans    &trans          &kp DEL         &none           &mkp MB1        &mclk_or_scroll 5 MB2  &trans  &trans
&browser_zoom_reset      &trans           &kp END         &trans          &kp PAGE_DOWN    &trans    &trans    &trans          &kp END         &mkp MB5        &kp DOWN_ARROW  &kp PAGE_DOWN           &trans  &trans
&trans                   &trans           &trans          &trans          &trans           &trans    &trans    &kp LEFT_ARROW  &kp RIGHT_ARROW                                                         &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &mkp MB4   &kp HOME         &kp UP_ARROW    &kp PAGE_UP            &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans     &kp LEFT_ARROW   &mkp MB1        &mclk_or_scroll 8 MB2  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &mkp MB5   &kp END          &kp DOWN_ARROW  &kp PAGE_DOWN          &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans                                                             &trans           &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_6 {
            bindings = <
&mac_dictation     &kp C_BRI_UP  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans                    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &trans
&trans             &kp C_BRI_DN  &kp C_PREV    &kp C_PP    &kp C_NEXT    &trans  &trans    &trans  &to 0          &to 0          &to 0          &to 1          &to 0          &trans
&win_voice_typing  &trans        &trans        &trans      &trans        &trans  &trans    &trans  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &trans
&trans             &trans        &trans        &trans      &trans        &trans  &trans    &trans  &tog 9                                                      &trans         &bt BT_CLR
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans      &trans      &trans    &trans       &trans                      &trans   &trans       &trans         &trans           &win_screenshot_tool  &trans
&trans  &kp EXCL    &kp LS(N2)  &kp HASH  &kp DLLR     &kp BSPC  &trans    &trans  &kp DEL  &kp PERCENT  &kp LS(N6)     &kp LS(N7)       &kp LBKT              &kp LS(EQUAL)
&trans  &trans      &trans      &trans    &kp LS(LBKT) &trans    &trans    &trans  &trans   &kp EQUAL    &kp LS(INT3)   &kp KP_MULTIPLY  &kp LS(INT1)          &kp LS(N8)
&trans  &trans      &trans      &trans    &trans       &trans    &trans    &trans  &trans                                                &trans                &kp LS(N9)
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer_10 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };
    };
};
